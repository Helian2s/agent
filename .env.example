# Optional: use a named AWS CLI profile instead of hard-coded credentials.
AWS_PROFILE=default

# Required unless you only rely on `bedrock.region` in the YAML config.
AWS_REGION=us-east-1

# Optional: point the app at a different YAML file.
# AGENT_CONFIG_PATH=config/agent.local.yaml

# If you do not use `AWS_PROFILE`, you can instead provide the standard AWS
# credential variables locally in `.env` or your shell:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
